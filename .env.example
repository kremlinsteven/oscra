# All optional. Copy to .env.local and fill only what you need. See README.md.
# Private Solana RPC for the server / the browser. Empty = public RPC (server: api.mainnet-beta.solana.com, browser: solana-rpc.publicnode.com).
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=
# Record store (kv-gateway REST): follows, ideas, fills and poll votes. Without it those writes answer 503 on a deployment.
KV_REST_API_URL=
KV_REST_API_TOKEN=
